+bool ieee80211_rx_shortcut_prepare(struct ieee80211_sta *pubsta,
+				  struct ieee80211_key_conf *keyconf, u8 tid,
+				  u16 next_seq, const u8 pn[6])
+{
+	struct sta_info *sta = container_of(pubsta, struct sta_info, sta);
+	struct ieee80211_key *key = container_of(keyconf, struct ieee80211_key, conf);
+	struct ieee80211_local *local = sta->sdata->local;
+	struct tid_ampdu_rx *ba;
+	bool ready = false;
+
+	spin_lock_bh(&local->rx_path_lock);
+	if (keyconf->cipher != WLAN_CIPHER_SUITE_CCMP || key->sta != sta ||
+	    !test_sta_flag(sta, WLAN_STA_AUTHORIZED) ||
+	    memcmp(key->u.ccmp.rx_pn[tid], pn, 6))
+		goto out;
+	ba = rcu_dereference(sta->ampdu_mlme.tid_rx[tid]);
+	if (ba) {
+		spin_lock_bh(&ba->reorder_lock);
+		ready = !ba->stored_mpdu_num && ba->head_seq_num == next_seq;
+		spin_unlock_bh(&ba->reorder_lock);
+	} else {
+		ready = sta->last_seq_ctrl[tid] == cpu_to_le16(((next_seq - 1) & 4095) << 4);
+	}
+out:
+	spin_unlock_bh(&local->rx_path_lock);
+	return ready;
+}
+EXPORT_SYMBOL_GPL(ieee80211_rx_shortcut_prepare);
+
+void ieee80211_rx_shortcut_sync(struct ieee80211_sta *pubsta,
+			       struct ieee80211_key_conf *keyconf, u8 tid,
+			       u16 next_seq, const u8 pn[6], u16 received)
+{
+	struct sta_info *sta = container_of(pubsta, struct sta_info, sta);
+	struct ieee80211_key *key = container_of(keyconf, struct ieee80211_key, conf);
+	struct ieee80211_local *local = sta->sdata->local;
+
+	spin_lock_bh(&local->rx_path_lock);
+	if (keyconf->cipher == WLAN_CIPHER_SUITE_CCMP && key->sta == sta) {
+		if (memcmp(pn, key->u.ccmp.rx_pn[tid], 6) > 0)
+			memcpy(key->u.ccmp.rx_pn[tid], pn, 6);
+		sta->last_seq_ctrl[tid] = cpu_to_le16(((next_seq - 1) & 4095) << 4);
+	}
+	spin_unlock_bh(&local->rx_path_lock);
+	ieee80211_mark_rx_ba_filtered_frames(pubsta, tid, next_seq, 0, received);
+}
+EXPORT_SYMBOL_GPL(ieee80211_rx_shortcut_sync);
+
+void ieee80211_rx_shortcut_account(struct ieee80211_sta *pubsta, u8 tid,
+				  u32 mpdus, u32 msdus, u32 bytes)
+{
+	struct sta_info *sta = container_of(pubsta, struct sta_info, sta);
+	struct ieee80211_local *local = sta->sdata->local;
+	struct ieee80211_sta_rx_stats *stats = &sta->deflink.rx_stats;
+	struct tid_ampdu_rx *ba;
+
+	spin_lock_bh(&local->rx_path_lock);
+	stats->last_rx = jiffies;
+	stats->fragments += mpdus;
+	stats->packets += mpdus;
+	u64_stats_update_begin(&stats->syncp);
+	stats->bytes += bytes;
+	stats->msdu[tid] += msdus;
+	u64_stats_update_end(&stats->syncp);
+	ba = rcu_dereference(sta->ampdu_mlme.tid_rx[tid]);
+	if (ba && ba->timeout) WRITE_ONCE(ba->last_rx, jiffies);
+	spin_unlock_bh(&local->rx_path_lock);
+}
+EXPORT_SYMBOL_GPL(ieee80211_rx_shortcut_account);
 
